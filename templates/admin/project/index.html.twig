{% extends 'admin/layout.html.twig' %}

{% set breadcrumbs = [
    {label: 'nav.dashboard'|trans, url: path('admin_dashboard')},
    {label: 'project.projects_title'|trans}
] %}
{% set page_desc = filterUser is defined and filterUser ? ('project.projects_of'|trans ~ ' ' ~ filterUser.name) : 'project.projects_desc'|trans %}

{% block page_title %}{{ 'project.projects_title'|trans }}{% endblock %}

{% block topbar_actions %}{% endblock %}

{% block content %}
<div class="d2-body">

{% include 'admin/project/_project_header_bar.html.twig' with {title_override: ('project.projects_title'|trans ~ ':')} %}

{% macro project_card(project, filterUserId) %}
    {% set pColor = project.color ?: '#4945FF' %}
    {% set projTypes = admin_content_types_for_project(project) %}
    {% set pLink = path('admin_switch_project', {id: project.id, _redirect: path('admin_projects', filterUserId > 0 ? {user: filterUserId} : {})}) %}
    <div class="d2-panel" data-project-id="{{ project.id }}">
        <div class="d2-panel-head">
            <div class="d2-panel-head-left">
                <div class="d2-project-head-icon" style="background:{{ pColor }}20; border-color:{{ pColor }}40; color:{{ pColor }};">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <div>
                    <div class="d2-panel-title">{{ project.name }}</div>
                    {% if project.description %}
                    <div class="d2-panel-subtitle">{{ project.description }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="d2-panel-head-right">
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_switch_project', {id: project.id, _redirect: path('admin_content_type_new')}) }}"
                   class="cyber-btn-primary cyber-btn--compact" style="margin-right:8px;">
                    <i class="bi bi-plus-lg"></i> <span>{{ 'action.new_section'|trans }}</span>
                </a>
                <a href="{{ path('admin_project_edit', {id: project.id}) }}" class="cyber-btn cyber-btn--icon cyber-btn--edit" title="{{ 'action.edit_project'|trans }}">
                    <i class="bi bi-pencil"></i>
                </a>
                {% endif %}
            </div>
        </div>
        <div class="d2-panel-body">
            <div class="row g-3 project-cards-grid">
                {% for ct in projTypes %}
                {% set entriesCount = ct.entries|length %}
                {% set ctLink = path('admin_switch_project', {id: project.id, _redirect: path('admin_entry_by_type', {slug: ct.slug})}) %}
                <div class="col-md-6 col-lg-4">
                    <div class="cyber-card project-content-card" data-anim="cyber-card" data-link="{{ ctLink }}">
                        <div class="project-content-card__header">
                            <div class="cyber-section-icon project-content-card__section-icon">
                                <i class="bi bi-file-earmark"></i>
                            </div>
                            <span class="cyber-badge cyber-badge--compact {{ entriesCount > 0 ? 'cyber-badge--mod' : '' }}">
                                {{ entriesCount }} {{ 'project.entries_count'|trans }}
                            </span>
                        </div>
                        <div class="project-content-card__body">
                            <h3 class="project-content-card__title">{{ ct.name }}</h3>
                            {% if ct.description %}
                            <p class="project-content-card__desc">{{ ct.description }}</p>
                            {% endif %}
                        </div>
                        <a href="{{ ctLink }}" class="cyber-btn cyber-btn--projects project-content-card__btn">
                            <i class="bi bi-eye"></i> <span>{{ 'action.view_entries'|trans }}</span>
                        </a>
                    </div>
                </div>
                {% else %}
                <div class="col-12">
                    <div class="cyber-card cyber-card--empty" data-anim="cyber-card">
                        <div class="cyber-empty-icon--xl">
                            <i class="bi bi-layers"></i>
                        </div>
                        <p class="field-help-text field-help-text--action">Aquest projecte no té seccions encara</p>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ pLink }}" class="cyber-btn-primary cyber-btn--compact">
                            <i class="bi bi-plus-lg"></i> <span>Crear secció</span>
                        </a>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endmacro %}

{% macro status_badges(projTypes) %}
    {% set pub = 0 %}{% set drf = 0 %}{% set arc = 0 %}{% set sch = 0 %}
    {% for ct in projTypes %}
        {% for e in ct.entries %}
            {% if e.status == 'published' %}{% set pub = pub + 1 %}
            {% elseif e.status == 'draft' %}{% set drf = drf + 1 %}
            {% elseif e.status == 'archived' %}{% set arc = arc + 1 %}
            {% elseif e.status == 'scheduled' %}{% set sch = sch + 1 %}
            {% endif %}
        {% endfor %}
    {% endfor %}
    <div class="d2-entry-states">
        <span class="d2-entry-state {{ pub == 0 ? 'd2-entry-state--empty' : '' }}">
            <i class="fa-solid fa-circle-check d2-status-icon--publicats"></i> {{ pub }}
        </span>
        <span class="d2-entry-state d2-entry-state--draft {{ drf == 0 ? 'd2-entry-state--empty' : '' }}">
            <i class="fa-solid fa-file-pen d2-status-icon--esboranys"></i> {{ drf }}
        </span>
        <span class="d2-entry-state d2-entry-state--archived {{ arc == 0 ? 'd2-entry-state--empty' : '' }}">
            <i class="fa-solid fa-hourglass-half d2-status-icon--revisio"></i> {{ arc }}
        </span>
        <span class="d2-entry-state d2-entry-state--scheduled {{ sch == 0 ? 'd2-entry-state--empty' : '' }}">
            <i class="fa-solid fa-clock d2-status-icon--cancelat"></i> {{ sch }}
        </span>
    </div>
{% endmacro %}

{% if filterUser is defined and filterUser %}
{# ═══════════════════════════════════
   Single-user view (filterUser) — table view
   ═══════════════════════════════════ #}
{% if is_granted('ROLE_ADMIN') %}
<div class="d2-back-row">
    <a href="{{ path('admin_projects') }}" class="d2-back-link">
        <i class="bi bi-arrow-left"></i> Tots els projectes
    </a>
</div>
{% endif %}

{% set allProjects = mainProject ? [mainProject]|merge(otherProjects) : otherProjects %}

{% if allProjects|length > 0 %}
<div class="d2-panel">
    <div class="d2-panel-body d2-panel-body--flush">
        <table class="cyber-table">
            <thead>
                <tr>
                    <th>{{ 'project.project_col'|trans }}</th>
                    <th>{{ 'project.entries_count'|trans|upper }}</th>
                    <th>{{ 'project.published_col'|trans }}</th>
                    <th>{{ 'project.status_col'|trans|upper }}</th>
                    <th>{{ 'project.actions_col'|trans|upper }}</th>
                </tr>
            </thead>
            <tbody>
    {% for proj in allProjects %}
    {% set projTypes = admin_content_types_for_project(proj) %}
    {% set totalEntries = projTypes|reduce((carry, ct) => carry + ct.entries|length, 0) %}
                <tr class="cyber-row {{ proj.active ? 'row-active' : 'row-inactive' }}" data-id="{{ proj.id }}">
                    <td class="cyber-cell">
                        <div class="cyber-cell__project-info">
                            <span class="cyber-badge" style="width:8px;height:8px;border-radius:50%;padding:0;display:inline-block;background:{{ proj.color ?: '#4945FF' }};flex-shrink:0;"></span>
                            <div class="table-project-name">
                                <a href="{{ path('admin_switch_project', {id: proj.id, _redirect: path('admin_project_show', {id: proj.id})}) }}"
                                   style="color:inherit;text-decoration:none;">{{ proj.name }}</a>
                            </div>
                        </div>
                    </td>
                    <td class="cyber-cell"><span style="font-weight:800;font-size:0.9rem;background:linear-gradient(135deg,#f97316,#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">{{ totalEntries }}</span></td>
                    <td class="cyber-cell">{{ _self.status_badges(projTypes) }}</td>
                    <td class="cyber-cell">
                        {% if proj.active %}
                            <span class="cyber-status-dot cyber-status-dot--active" style="display:inline-block;margin-right:4px;"></span>
                            <span class="cyber-status-text">{{ 'status.active'|trans }}</span>
                        {% else %}
                            <span class="cyber-status-dot" style="display:inline-block;background:rgba(148,163,184,0.4);margin-right:4px;"></span>
                            <span class="cyber-status-text--draft">{{ 'status.inactive'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="cyber-cell" style="text-align:right;white-space:nowrap;">
                        <a href="{{ path('admin_switch_project', {id: proj.id, _redirect: path('admin_project_show', {id: proj.id})}) }}"
                           class="cyber-btn cyber-btn--icon" title="Veure projecte" style="margin-right:4px;">
                            <i class="bi bi-eye"></i>
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_project_edit', {id: proj.id}) }}"
                           class="cyber-btn cyber-btn--icon cyber-btn--edit" title="Editar" style="margin-right:4px;">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="{{ path('admin_content_type_new') }}"
                           class="cyber-btn cyber-btn--icon" title="Nova secció" style="margin-right:4px;">
                            <i class="bi bi-plus-lg"></i>
                        </a>
                        {% endif %}
                    </td>
                </tr>
    {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="d2-empty-state">
    <div class="d2-empty-state-icon">
        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" opacity="0.3">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
    </div>
    <div class="d2-empty-state-text">
        <strong>No tens cap projecte assignat</strong>
        <p>Posa't en contacte amb l'administrador per assignar-te projectes.</p>
    </div>
</div>
{% endif %}

{% elseif projects is defined and is_granted('ROLE_ADMIN') %}
{# ═══════════════════════════════════
   All projects view (grouped by client) — admin only
   Table view, no cards
   ═══════════════════════════════════ #}
{% set currentUserId = -1 %}
{% for project in projects %}
{% set pid = project.user ? project.user.id : 0 %}

{% if pid != currentUserId %}
  {% set currentUserId = pid %}
  {% if not loop.first %}</tbody></table></div></div>{% endif %}

<div class="d2-panel">
    <div class="d2-panel-head">
        <div class="d2-panel-head-left">
            <div class="d2-cli-av" style="background:{% if project.user %}{{ ['#3b82f6','#64748b','#f59e0b','#22c55e','#a855f7','#ec4899','#06b6d4','#14b8a6'][project.user.id % 8] }}{% else %}#64748b{% endif %};">
                {{ project.user ? project.user.name|first|upper : '?' }}
            </div>
            <div>
                <div class="d2-panel-title">{{ project.user ? project.user.name : 'Sense client' }}</div>
                {% if project.user %}
                <div class="d2-panel-subtitle">{{ project.user.email }}</div>
                {% endif %}
            </div>
        </div>
        <div class="d2-panel-head-right">
            <span class="d2-client-count">
                {{ projects|filter(p => (p.user ? p.user.id : 0) == pid)|length }} projectes
            </span>
            {% if project.user %}
            <a href="{{ path('admin_project_new', {user: project.user.id}) }}"
               class="cyber-btn-primary cyber-btn--compact">
                <i class="bi bi-plus-lg"></i> <span>Nou</span>
            </a>
            {% endif %}
        </div>
    </div>
    <div class="d2-panel-body d2-panel-body--flush">
         <table class="cyber-table cyber-table--projects">
            <thead>
                <tr>
                    <th>Projecte</th>
                    <th>Entrades</th>
                    <th>Publicades</th>
                    <th>Estat</th>
                    <th>Accions</th>
                </tr>
            </thead>
            <tbody>
{% endif %}
                <tr class="cyber-row {{ project.active ? 'row-active' : 'row-inactive' }}" data-id="{{ project.id }}">
                    <td class="cyber-cell">
                        <div class="cyber-cell__project-info">
                            <span class="cyber-badge" style="width:8px;height:8px;border-radius:50%;padding:0;display:inline-block;background:{{ project.color ?: '#4945FF' }};flex-shrink:0;"></span>
                            <div class="table-project-name">
                                <a href="{{ path('admin_switch_project', {id: project.id, _redirect: path('admin_project_show', {id: project.id})}) }}"
                                   style="color:inherit;text-decoration:none;">{{ project.name }}</a>
                            </div>
                        </div>
                    </td>
                    <td class="cyber-cell">
                        {% set projTypes = admin_content_types_for_project(project) %}
                        {% set totalEntries = projTypes|reduce((carry, ct) => carry + ct.entries|length, 0) %}
                        <span style="font-weight:800;font-size:0.9rem;background:linear-gradient(135deg,#f97316,#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">{{ totalEntries }}</span>
                    </td>
                    <td class="cyber-cell">{{ _self.status_badges(projTypes) }}</td>
                    <td class="cyber-cell">
                        {% if project.active %}
                            <span class="cyber-status-dot cyber-status-dot--active" style="display:inline-block;margin-right:4px;"></span>
                            <span class="cyber-status-text">Actiu</span>
                        {% else %}
                            <span class="cyber-status-dot" style="display:inline-block;background:rgba(148,163,184,0.4);margin-right:4px;"></span>
                            <span class="cyber-status-text--draft">Inactiu</span>
                        {% endif %}
                    </td>
                    <td class="cyber-cell" style="text-align:right;white-space:nowrap;">
                        <a href="{{ path('admin_switch_project', {id: project.id, _redirect: path('admin_project_show', {id: project.id})}) }}"
                           class="cyber-btn cyber-btn--icon" title="Veure projecte" style="margin-right:4px;">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('admin_project_edit', {id: project.id}) }}"
                           class="cyber-btn cyber-btn--icon cyber-btn--edit" title="Editar" style="margin-right:4px;">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% if project.id not in protectedProjectIds|default([]) %}
                        <form method="post" action="{{ path('admin_project_delete', {id: project.id}) }}"
                              class="cyber-form--inline" id="del-project-{{ project.id }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-project-' ~ project.id) }}">
                            <button type="button"
                                    class="cyber-btn cyber-btn--icon cyber-btn--delete"
                                    title="Eliminar"
                                    data-confirm="Segur que vols eliminar el projecte {{ project.name }}?"
                                    data-form="del-project-{{ project.id }}">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
{% if loop.last %}</tbody></table></div></div>{% endif %}
{% else %}
<div class="d2-empty-state">
    <div class="d2-empty-state-icon">
        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" opacity="0.3">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
    </div>
    <div class="d2-empty-state-text">
        <strong>No hi ha projectes</strong>
        <p>Crea el primer projecte per començar.</p>
        <p><a href="{{ path('admin_project_new') }}">Crear projecte</a></p>
    </div>
</div>
{% endfor %}
{% endif %}

</div> {# /d2-body #}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% include 'admin/components/_help_faq.html.twig' with { form_context: 'projects_index' } %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  // ─── Project delete confirmation ───
  var delBtns = document.querySelectorAll('[data-confirm]');
  for (var i = 0; i < delBtns.length; i++) {
    delBtns[i].addEventListener('click', function () {
      var msg = this.getAttribute('data-confirm');
      var formId = this.getAttribute('data-form');
      if (confirm(msg)) {
        var form = document.getElementById(formId);
        if (form) form.submit();
      }
    });
  }
});
</script>
{% endblock %}