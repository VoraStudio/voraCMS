{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {# Google Fonts for dashboard #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Merriweather:wght@400;700;900&family=JetBrains+Mono:wght@400;500;600;700&family=Syne:wght@400;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

    {# VoraAdmin modular stylesheets #}
    <link rel="stylesheet" href="{{ asset('css/admin/layout.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/components.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/forms.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/tables.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/dashboard.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/login.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/media.css') }}?v=3.0">
    <link rel="stylesheet" href="{{ asset('css/admin/api-guide.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/vt-preview.css') }}?v=2.0">
    <link rel="stylesheet" href="{{ asset('css/admin/theme.css') }}?v=2.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="{{ asset('js/admin-animations.js') }}"></script>
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}

{% block body %}
<div class="s-body">

    {# ─── Sidebar ─── #}
    <nav class="s-sidebar" id="adminSidebar">
        <a class="s-sidebar-brand" href="{{ path('admin_dashboard') }}">
            <img src="{{ asset('img/logoVora.png') }}" alt="Vora Studio" class="s-sidebar-logo">
        </a>

        {# ─── Navigation ─── #}
        <div class="s-sidebar-nav">
            <div class="s-sidebar-section">{{ 'nav.general'|trans }}</div>

            <a class="s-sidebar-link{% if app.request.get('_route') == 'admin_dashboard' %} active{% endif %}" href="{{ path('admin_dashboard') }}">
                <i class="bi bi-grid-1x2-fill"></i> {{ 'nav.dashboard'|trans }}
            </a>

            {# ─── Project selector / current project ─── #}
            {% set sidebarTypes = admin_content_types() %}
            <a class="s-sidebar-link{% if app.request.get('_route') starts with 'admin_project_' %} active{% endif %}" href="{{ path('admin_projects') }}">
                <i class="bi bi-folder"></i> {{ 'nav.projects'|trans }}
            </a>
            {% if is_granted('ROLE_ADMIN') %}
            <a class="s-sidebar-link{% if app.request.get('_route') starts with 'admin_user_' %} active{% endif %}" href="{{ path('admin_user_index') }}">
                <i class="bi bi-people"></i> {{ 'nav.users'|trans }}
            </a>
            {% endif %}

            {# ─── Seccions (gestió de tipus de contingut i plantilles globals) ─── #}
            {% if is_granted('ROLE_ADMIN') %}
            <a class="s-sidebar-link{% if app.request.get('_route') starts with 'admin_content_type_' or app.request.get('_route') starts with 'admin_base_content_' %} active{% endif %}" href="{{ path('admin_content_type_index') }}">
                <i class="bi bi-layers-fill"></i> {{ 'nav.content_types'|trans }}
            </a>
            {% endif %}

            <a class="s-sidebar-link{% if app.request.get('_route') == 'admin_media_index' %} active{% endif %}" href="{{ path('admin_media_index') }}">
                <i class="bi bi-images"></i> {{ 'nav.media'|trans }}
            </a>

            {# ─── Si hi ha projecte actiu → mostrem les seves seccions ─── #}
            {% if sidebarTypes is not empty %}
            <div class="s-sidebar-section">
                {% if activeProject is defined and activeProject %}
                    {{ activeProject.name }}
                {% else %}
                    Continguts
                {% endif %}
            </div>
            {% for ct in sidebarTypes %}
            <a class="s-sidebar-link text-capitalize{% if app.request.get('slug') == ct.slug %} active{% endif %}" href="{{ path('admin_entry_by_type', {slug: ct.slug}) }}">
                <i class="bi bi-file-text"></i> {{ ct.name }}
            </a>
            {% endfor %}
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
            <div class="s-sidebar-section">{{ 'nav.developer'|trans }}</div>
            <a class="s-sidebar-link{% if app.request.get('_route') == 'admin_api_guide' %} active{% endif %}" href="{{ path('admin_api_guide') }}">
                <i class="bi bi-code-slash"></i> {{ 'nav.api_guide'|trans }}
            </a>
            <a class="s-sidebar-link s-sidebar-link--sub{% if app.request.get('_route') == 'admin_api_guide_security' %} active{% endif %}" href="{{ path('admin_api_guide_security') }}">
                <i class="bi bi-shield-check"></i> {{ 'nav.security'|trans }}
            </a>
            <a class="s-sidebar-link s-sidebar-link--sub{% if app.request.get('_route') == 'admin_api_guide_tests' %} active{% endif %}" href="{{ path('admin_api_guide_tests') }}">
                <i class="bi bi-check-circle"></i> {{ 'nav.jwt_tests'|trans }}
            </a>
            <div class="s-sidebar-group{% if app.request.get('_route') == 'admin_api_guide_jwt' %} is-open{% endif %}">
                <a class="s-sidebar-link s-sidebar-link--sub{% if app.request.get('_route') == 'admin_api_guide_jwt' %} active{% endif %} s-sidebar-group-toggle" href="{{ path('admin_api_guide_jwt') }}">
                    <i class="bi bi-key-fill"></i> JWT
                    <i class="bi bi-chevron-down s-sidebar-group-arrow"></i>
                </a>
                <div class="s-sidebar-group-children">
                    <a class="s-sidebar-link s-sidebar-link--sub-deep" href="{{ path('admin_api_guide_jwt') }}#master-token">
                        <i class="bi bi-magic"></i> Master Token
                    </a>
                    <a class="s-sidebar-link s-sidebar-link--sub-deep" href="{{ path('admin_api_guide_jwt') }}#validacio-client">
                        <i class="bi bi-diagram-3-fill"></i> Validació per client
                    </a>
                    <a class="s-sidebar-link s-sidebar-link--sub-deep" href="{{ path('admin_api_guide_jwt') }}#obtenir-jwt">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    <a class="s-sidebar-link s-sidebar-link--sub-deep" href="{{ path('admin_api_guide_jwt') }}#ssr">
                        <i class="bi bi-server"></i> SSR
                    </a>
                </div>
            </div>
            {% endif %}

        </div>{# ─── /s-sidebar-nav ─── #}
    </nav>

    {# ─── Overlay (mobile) ─── #}
    <div class="s-sidebar-overlay"></div>

    {# ─── Main ─── #}
    <main class="s-main{% if app.request.get('_route') == 'admin_dashboard' %} s-main--dashboard{% endif %}">
        <div class="s-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="s-sidebar-toggle">
                    <i class="bi bi-list"></i>
                </button>
                <div class="s-topbar-header-area">
                    {% if breadcrumbs is defined and breadcrumbs is not empty %}
                        <div class="s-topbar-breadcrumbs">
                            {% for bc in breadcrumbs %}
                                {% if loop.last %}
                                    <span class="cyber-breadcrumb-item active">{{ bc.label }}</span>
                                {% else %}
                                    {% if bc.url is defined and bc.url %}
                                        <a href="{{ bc.url }}" class="cyber-breadcrumb-item">{{ bc.label }}</a>
                                    {% else %}
                                        <span class="cyber-breadcrumb-item">{{ bc.label }}</span>
                                    {% endif %}
                                    <span class="cyber-breadcrumb-separator">/</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                    <h1 class="s-topbar-title-gradient">{{ block('page_title') }}</h1>
                    {% if page_desc is defined and page_desc %}
                        <p class="s-topbar-desc">{{ page_desc }}</p>
                    {% elseif description is defined and description %}
                        <p class="s-topbar-desc">{{ description }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="s-topbar-actions">
                <!-- Topbar Search -->
                <div class="d2-search-wrapper d2-search-wrapper--topbar">
                    <input type="text" id="projectSearch" class="d2-search-input" placeholder="{{ 'user.search_placeholder'|trans }}">
                    <button type="button" class="d2-search-btn" title="{{ 'user.search_placeholder'|trans }}">
                        <i class="bi bi-search"></i>
                    </button>
                </div>

                {# ─── Language selector ─── #}
                {% set currentLocale = app.request.locale|default('ca') %}
                <div class="s-lang-switcher" id="langSwitcher">
                    <button type="button" class="s-lang-btn" id="langBtn" aria-label="Canviar idioma" title="Idioma">
                        <i class="bi bi-translate s-lang-icon"></i>
                        <span class="s-lang-current">{{ currentLocale|upper }}</span>
                        <i class="bi bi-chevron-down s-lang-chevron"></i>
                    </button>
                    <div class="s-lang-menu" id="langMenu">
                        <a href="{{ path('admin_switch_locale', {locale: 'ca'}) }}" class="s-lang-item{% if currentLocale == 'ca' %} active{% endif %}">
                            <span class="s-lang-code">CAT</span>
                            <span class="s-lang-label">Català</span>
                            {% if currentLocale == 'ca' %}<i class="bi bi-check2"></i>{% endif %}
                        </a>
                        <a href="{{ path('admin_switch_locale', {locale: 'es'}) }}" class="s-lang-item{% if currentLocale == 'es' %} active{% endif %}">
                            <span class="s-lang-code">ESP</span>
                            <span class="s-lang-label">Español</span>
                            {% if currentLocale == 'es' %}<i class="bi bi-check2"></i>{% endif %}
                        </a>
                        <a href="{{ path('admin_switch_locale', {locale: 'en'}) }}" class="s-lang-item{% if currentLocale == 'en' %} active{% endif %}">
                            <span class="s-lang-code">ENG</span>
                            <span class="s-lang-label">English</span>
                            {% if currentLocale == 'en' %}<i class="bi bi-check2"></i>{% endif %}
                        </a>
                    </div>
                </div>

                {# ─── Theme toggle ─── #}
                <button class="s-theme-toggle" id="themeToggle" title="{{ 'user.theme_toggle'|trans }}">
                    <i class="bi bi-sun-fill s-theme-icon-light"></i>
                    <i class="bi bi-moon-fill s-theme-icon-dark"></i>
                </button>
                {# ─── Help / FAQ ─── #}
                <button class="s-help-toggle faq-btn" type="button" title="{{ 'user.help_title'|trans }}" aria-label="{{ 'user.help_title'|trans }}">
                    <i class="bi bi-question-circle-fill"></i>
                </button>
                {# ─── User card ─── #}
                {% include 'admin/_user_card.html.twig' %}
            </div>
        </div>

        {# ─── Action Bar (just a sota del topbar) ─── #}
        {% set topbarActionsHtml %}
            {% block topbar_actions %}{% endblock %}
        {% endset %}
        {% if topbarActionsHtml|trim is not empty %}
            <div class="s-action-bar">
                {{ topbarActionsHtml|raw }}
            </div>
        {% endif %}

        <div class="s-content">
            {% block content %}{% endblock %}
        </div>

        <div class="s-footer">
            Desenvolupat per <img src="{{ asset('img/logoVora.png') }}" alt="Vora Studio">
        </div>
    </main>
</div>

{# ─── Flash messages → SweetAlert toasts ─── #}
<div id="flashData" class="flash-data"
     data-flash='{
         "success": [
             {% for msg in app.flashes('success') %}
                 {{ msg|json_encode|raw }}{{ loop.last ? '' : ',' }}
             {% endfor %}
         ],
         "error": [
             {% for msg in app.flashes('error') %}
                 {{ msg|json_encode|raw }}{{ loop.last ? '' : ',' }}
             {% endfor %}
         ],
         "warning": [
             {% for msg in app.flashes('warning') %}
                 {{ msg|json_encode|raw }}{{ loop.last ? '' : ',' }}
             {% endfor %}
         ],
         "info": [
             {% for msg in app.flashes('info') %}
                 {{ msg|json_encode|raw }}{{ loop.last ? '' : ',' }}
             {% endfor %}
         ]
     }'></div>
{% endblock %}
